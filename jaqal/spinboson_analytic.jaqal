// Spin-dependent squeezing, analytic stroboscopic protocol.
// Pulses come from results/data/analytic_jaqalpaw.json, written by
//   julia --project=. scripts/export_analytic_jaqalpaw.jl
//
// Compile / inspect the waveform with:
//   .venv/bin/jaqalpaw-emulate -s jaqal/spinboson_analytic.jaqal

from .spinboson_pulses usepulses *

// RFSoC channel of the addressed ion (Q0 in QSCOUTBuiltins).
let target 2

register q[8]

prepare_all

SBSqueeze q[target]

measure_all
