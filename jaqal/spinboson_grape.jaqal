// Spin-dependent squeezing, two-spin GRAPE pulse.
// Pulses come from results/data/ion_GRAPE_2spin_controls_jaqalpaw.json,
// written by
//   julia --project=. scripts/ion_GRAPE_2spin.jl      // optimize (slow)
//   julia --project=. scripts/export_jaqalpaw.jl      // convert to JSON
//
// The gate reads whichever drive file $SPINBOSON_PULSE_FILE names, so point it
// at the two-spin export before compiling or emulating:
//
//   SPINBOSON_PULSE_FILE=results/data/ion_GRAPE_2spin_controls_jaqalpaw.json \
//       .venv/bin/jaqalpaw-emulate -s jaqal/spinboson_grape.jaqal

from .spinboson_pulses usepulses *

// RFSoC channels of the two addressed ions (Q0, Q1 in QSCOUTBuiltins).
let ion1 2
let ion2 3

register q[8]

prepare_all

SBSqueeze2 q[ion1] q[ion2]

measure_all
